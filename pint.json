{
    "preset": "laravel",
    "notPath": [
        "packages/turbulence/config/turbulence.php",
        "build",
        "*/build/*",
        "**/build/**",
        ".phpunit.cache",
        "*/.phpunit.cache/*",
        "**/.phpunit.cache/**"
    ],
    "rules": {
        "declare_strict_types": true,
        "fully_qualified_strict_types": true,
        "single_trait_insert_per_statement": true,
        "array_syntax": true
    }
}
