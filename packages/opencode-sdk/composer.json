{
	"name": "artisan-build/opencode-sdk",
	"description": "A Saloon generated SDK for opencode",
	"type": "library",
	"license": "MIT",
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/artisan-build/saloon-sdk-generator.git"
		}
	],
	"require": {
        "crescat-io/saloon-sdk-generator": "dev-laravel-12-support",
        "saloonphp/saloon": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^v9.9.0",
        "pestphp/pest": "^v3.7.1",
        "laravel/pint": "^1.19.0",
        "phpstan/phpstan": "^2.1.0"
    },
	"autoload": {
		"psr-4": {
			"ArtisanBuild\\OpencodeSdk\\": "src/",
			"ArtisanBuild\\OpencodeSdk\\Tests\\": "tests/"
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"laravel": {
			"providers": [
				"ArtisanBuild\\OpencodeSdk\\Providers\\OpencodeSdkServiceProvider"
			]
		}
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	},
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-bench --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "lint": "vendor/bin/pint",
        "stan": "vendor/bin/phpstan analyse --memory-limit=-1",
        "ready": [
            "@composer lint",
            "@composer stan",
            "@composer test"
        ]
    }
}
